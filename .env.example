# Copy to .env and fill in. .env is git- and docker-ignored; never commit it.
# Format for `docker run --env-file .env`: KEY=value, no quotes, no spaces around "=".

AZDO_ORG_URL=https://dev.azure.com/my-org
# Personal access token: Code (Read & write) + Pull Request Threads (Read & write)
AZDO_PAT=
# Identity ID (GUID) of the reviewer group that triggers an enhancement
AI_REVIEWER_ID=

# Any OpenAI-compatible server, including /v1. From inside a container use an
# address the container can reach (an IP or DNS name, not localhost or *.local).
AI_BASE_URL=http://my-llm-host:8080/v1
# AI_MODEL=
# AI_API_KEY=

# update = rewrite the PR, suggest = only comment
ENHANCE_MODE=update
# Basic-auth password Azure DevOps must send, e.g. `openssl rand -hex 24`
WEBHOOK_SECRET=
